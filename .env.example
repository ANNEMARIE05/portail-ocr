# URL d’origine du gateway (sans slash final), ex. https://api.exemple.com
NEXT_PUBLIC_API_BASE_URL=

# Préfixes de service (chemins ajoutés après la base), ex. /customer-service/api/v1
NEXT_PUBLIC_API_USER_SERVICE=
NEXT_PUBLIC_API_ADMIN_SERVICE=
NEXT_PUBLIC_API_BILLING_SERVICE=

# Après connexion : localStorage "token" (jeton Bearer) et "userinfo" (JSON avec au minimum id ; email affiché dans le tableau et l’assistance si présent).
#
# Retour après paiement (passerelle) : configurer l’URL de callback vers la page reçu, par ex.
#   https://votre-domaine.example/user/achats/retour
# La page accepte des query params courants (status, transaction_id, reference, etc.) — voir lib/paiement-recu-retour.ts
#
# Optionnel : WebSocket pour la messagerie ticket utilisateur (sans slash final), ex. ws://hôte:18002 — voir lib/api/tickets-api.ts
# NEXT_PUBLIC_WS_TICKETS_URL=
#
# Clôture ticket côté utilisateur : en plus du préfixe user-service, l’app tente
# PUT {NEXT_PUBLIC_API_BASE_URL}/customer-service/api/v1/tickets/{id}/close (gateway legacy).
